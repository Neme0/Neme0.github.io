@article{hovorka24injection,
  title={A Tale of Two Geologic Systems: Comparing the Impacts of Injection into the Permian Basin to the Gulf of Mexico},
  author={Hovorka, Susan and Smye, Katie M. and Hennings, Peter H. and Bump, Alexander P. and Okezie, Chinemerem C. and Luciano, Angela K.},
  year={2024},
  publisher={SSRN},
  abstract = {Policy makers, investors and the public have expressed concern about the viability of injection over many decades of very large volumes of CO2 into the deep subsurface. We test the conditions under which such injection is sustainable by assessing and comparing two contrasting geologic systems of North America where large volumes of produced wastewater have been injected into deep wells: the Permian Basin of west Texas and southeast New Mexico and the Gulf Coast Basin of Texas and Louisiana, U.S.A. The capacity of the Permian Basin has been challenged and, in some cases, exceeded in the past decade as a result of saltwater disposal (SWD), resulting in induced seismicity and surface flows of brine. In contrast, the Gulf Coast basin has also received large volumes of wastewater injection but as yet shows no evidence of local capacity exceedance. We inventory and compare the features that influence pressure-limited capacity as a first step toward integrating the lessons learned in the Permian Basin to de-risk injection into other basins with multiple-use for future injection, including very large CO2 injection},
  url = {https://papers.ssrn.com/sol3/papers.cfm?abstract_id=5064850},
  doi = {10.2139/ssrn.5064850},
  keywords = {Injection and pressure space limits},
  selected = {true},
  preview = {hovorkaetal24.gif},
  abbr = {Pressure Contour},
  bibtex_show = {false}
  
}
@article{okezie24calibration,
title={Calibrating Performaance Predictions for Large-Scale Injection},
author={Okezie, Chinemerem C. and Bump, Alexander P.},
year={2024},
publisher={SSRN},
abstract={The new incentive structure created for Carbon Capture and Storage (CCS) in the United States by the Bipartisan Infrastructure Law and the Inflation Reduction Act has dramatically changed the project landscape. After decades of pilot projects, experiments and CO2-EOR projects, there are now almost 60 CO2 storage projects in development on the Gulf Coast. Company websites and public announcements by the project developers suggest ambitious plans, with claimed injection rates of up to 20Mtpa. Comparing these announced rates with the number of wells currently in the corresponding Class VI permit applications suggests planned injection rates as high as 8Mtpa per well, which is many times higher than any historical CO2 injection on the Gulf. Potential geological barriers to flow, such as faults and facies changes are abundant in this region and could create closed compartments that rapidly pressure up, limiting injection. The combination of unprecedented planned rates and natural geologic complexity raises questions about chance of success and sustainability of rates for the duration of the project. To calibrate predictions of large-scale injection, we look at historical injection performance for saltwater disposal (SWD) related to hydrocarbon production on the Texas Gulf Coast from 1990 to 2020, the period for which digital records are available. To maximize the analog for CCS, we focus on injection into non-producing reservoirs within the same stratigraphic and depth intervals planned for CO2 storage. We use monthly injection volumes and average monthly injection pressures that were reported by SWD operators to the Texas Railroad Commission, and generously provided to us by B3 Insights, which aggregates the data and adds their own analysis. We find that the raw data needs significant QC to remove obvious outliers and other errors. Of the >8000 SWD Wells in the database, only 5,105 SWD wells have monthly volume data, 4,805 of which passed our QC. Pressure data were significantly less reliable, with apparent errors such as major outliers, anti-correlated pressure and volume trends, and months or even years of non-varying or zero pressure accompanied by fluctuating injection volumes. After QC to remove these errors, we identified 593 wells with reliable pressure data, which we used to compute injectivity indices. To calibrate predictions of CO2 injection, we translated results for single-phase flow into multi-phase flow using analytical methods. Initial results from this study show that the 4,805 wells with reliable volume data injected a total of ~20.3 billion bbl of saltwater into the onshore Texas Gulf of Mexico from 1990 to 2020. At reservoir conditions, that is volumetrically equivalent to ~2.3 Gt CO2. The bulk of this injection targeted Oligocene, Miocene, Woodbine, Wilcox, and surprisingly, Lower Cretaceous formations. For the 593 wells with reliable pressure data, we calculate injectivity indices to assess reservoir performance over the lifetime of each well. The results showed a wide distribution of injectivity indexes with a P90 of 5.38 bbl/day/psi (equivalent to ~0.61 Mt CO2/year/1000 psi), a p10 of 0.14 bbl /day/psi (equivalent to ~0.02 Mt CO2/year/1000 psi), and a standard deviation of 13.35. Analysis of variations in monthly injectivity indices over time shows no evidence of systematic change that might indicate pressure buildup or other adverse effects. The major limitations of this work stem from data quality, the location of water injection wells, and intermittent injection, which is not captured by monthly reporting. SWD wells are often nominally planned, drilled from existing well pads within a producing field, and minimally logged. The number of wells failing our QC attests to the data quality. The fact that wells are located within the footprint of producing fields means that they are almost universally on structural highs, which may be stratigraphically and/or structurally complex and not necessarily good anaolgs for the CCS wells, which are generally targeting synclines with potentially fewer faults and/or thicker, higher quality reservoirs. Perhaps the biggest limitation of this study comes from intermittent injection, however. It is common practice to store produced water in surface tanks and inject it when the tank fills up. With monthly reporting, it is not clear if wells were active for 30 days or for 3 (or less). For injectivity indices calculated on the basis of monthly volumes, intermittency could thus create apparent reductions of an order of magnitude or more. For all these reasons, the injectivity indices calculated here should be regarded as indications of minimum performance capability rather than likely capability. The sheer volume of historical SWD into non-productive formations shows that large-scale injection is possible in the onshore Texas Gulf Coast without adverse consequence. The observation of low injectivity indices for individual wells is more concerning. While a low injectivity index may be adequate for SWD, it suggests that large numbers of wells will be required for projects planning to store up to 10Mtpa of CO2. We stress caution in applying these results directly to predictions of CO2 injection performance. Intermittency, SWD requirements and anticlinal placement may all result in poorer (apparent) performance than might be reasonably expected for carefully planned, synclinally located CCS wells. Our results should thus be an indication of minimum reservoir performance rather than likely performance. Most encouragingly, we see no evidence of systematic pressure buildup that would limit injection duration.},
url={http://dx.doi.org/10.2139/ssrn.5065593},
doi={10.2139/ssrn.5065593},
keywords={Carbon Capture an Storage, Injectivity, Saltwater Disposal},
selected={true},
preview={pressure_contour.gif},
abbr={Pressure Contour},
bibtex_show={false}

}

